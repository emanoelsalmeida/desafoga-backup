{"nodes":[{"parameters":{"operation":"executeQuery","query":"SELECT \n  COALESCE(NULLIF(TRIM(u.frist_name), ''), SPLIT_PART(u.name, ' ', 1)) AS primeiro_nome,\n  u.phone,\n  (CURRENT_DATE - u.last_interaction_at::date)::int AS dias_sem_interacao\nFROM users u\nINNER JOIN subscriptions s ON s.user_phone = u.phone\nWHERE s.status = 'active'\n  AND s.valid_until >= CURRENT_DATE\n  AND u.last_interaction_at IS NOT NULL\n  AND (CURRENT_DATE - u.last_interaction_at::date) >= 7\nORDER BY u.last_interaction_at ASC;","options":{}},"id":"7046245f-4f28-47eb-84be-0e881c47ba83","name":"Buscar Usuários Ativos2","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[112,64],"credentials":{"postgres":{"id":"W02Ypncbc6O8Yfvu","name":"Conecta TDAH"}}},{"parameters":{"options":{}},"id":"80146b29-0481-454b-80e3-152d0c597da8","name":"Loop Usuários2","type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[336,64]},{"parameters":{},"type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[-112,160],"id":"8088ae81-f896-4bbf-aa28-e61a475a2c24","name":"When clicking ‘Execute workflow’"},{"parameters":{"mode":"insert","messages":{"messageValues":[{"type":"ai","message":"=Olá, {{ $('Loop Usuários2').item.json.primeiro_nome }}! Tudo bem?\n\nFaz 4 dias que o Desafoga TDAH não ouve a sua voz.\nEle foi feito pra uma coisa só: receber o seu áudio e transformar em tarefa organizada. \n\nNo Ecossistema Neurodiferente CEO De SI 🌟, ele trabalha enquanto o seu cérebro descansa.\nMe conta o que tá na sua mente hoje. \nEu devolvo organizado. 🤜🤛","hideFromUI":true}]}},"type":"@n8n/n8n-nodes-langchain.memoryManager","typeVersion":1.1,"position":[1232,64],"id":"28f73a38-d165-4a9a-af11-70b31de97cd1","name":"Chat Memory Manager"},{"parameters":{"sessionIdType":"customKey","sessionKey":"={{ $('Loop Usuários2').item.json.phone }}"},"type":"@n8n/n8n-nodes-langchain.memoryPostgresChat","typeVersion":1.3,"position":[1312,288],"id":"be3c1f31-30bd-4867-b8c3-dad99dc26900","name":"Postgres Ch