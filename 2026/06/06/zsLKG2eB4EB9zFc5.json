ar de outro jeito? Pode ser por áudio também.\"\n\nUsuário: \"🤯🔥🫠\"\nResposta: \"Seu cérebro parece estar em modo caos 😅 Me conta com palavras ou áudio o que tá acontecendo.\"\n\n\ninput:  {{ $('[SET] Padronizacao1').item.json.texto }}"}]},"builtInTools":{},"options":{}},"type":"@n8n/n8n-nodes-langchain.openAi","typeVersion":2.1,"position":[14608,5672],"id":"535b8dcc-60c3-47e2-a02d-7d60aa262f70","name":"Message a model","credentials":{"openAiApi":{"id":"AkYleDMMi1ZStZWC","name":"Connect TDAH"}}}],"connections":{"When Executed by Another Workflow":{"main":[[{"node":"[SET] Padronizacao1","type":"main","index":0}]]},"[SET] Padronizacao1":{"main":[[{"node":"Execution Data","type":"main","index":0},{"node":"Message a model","type":"main","index":0}]]},"Execution Data":{"main":[[]]},"Enviar WhatsApp1":{"main":[[{"node":"Salvar mensagem Uazapi","type":"main","index":0}]]},"Switch":{"main":[[{"node":"Send message","type":"main","index":0}],[{"node":"Send message","type":"main","index":0}],[{"node":"Send message","type":"main","index":0}]]},"Send message":{"main":[[{"node":"Salvar mensagem API","type":"main","index":0}]]},"Salvar mensagem API":{"main":[[{"node":"Update a row","type":"main","index":0}]]},"Salvar mensagem Uazapi":{"main":[[{"node":"Update a row","type":"main","index":0}]]},"Are we in eval mode?":{"main":[[{"node":"Create a row","type":"main","index":0}],[{"node":"Switch","type":"main","index":0}]]},"Message a model":{"main":[[{"node":"Are we in eval mode?","type":"main","index":0}]]}},"pinData":{"When Executed by Another Workflow":[{"json":{"text":"text","number":"5511992174614","message":{"type":"text","Timestamp":1779402719},"body":{"message":{"messageid":"wamid.HBgLMTc1NDQyMjY5MjEVAgASGBQzQUY2MUM2QkRCNUMwRDQyMTRBOQA="}},"origem":"API","frist_name":" Rc","quoted_message":"","gender":" masculino"}}]},"meta":{"templateCredsSetupCompleted":true}}