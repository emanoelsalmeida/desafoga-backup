Sao_Paulo')::date\n  ) AS atrasadas,\n  (\n    SELECT COALESCE(\n      json_agg(\n        json_build_object(\n          'titulo', title,\n          'categoria', COALESCE(category, 'Geral'),\n          'prioridade', COALESCE(priority, 0),\n          'horario', scheduled_time::text\n        ) ORDER BY scheduled_time NULLS LAST, priority DESC NULLS LAST\n      ),\n      '[]'::json\n    )\n    FROM tasks\n    WHERE user_phone = '{{ $json.user_phone }}'\n      AND status NOT IN ('done', 'archived')\n      AND due_date_typed = (now() AT TIME ZONE 'America/Sao_Paulo')::date\n  ) AS hoje,\n  (\n    SELECT frase\n    FROM frases_dopamina_seg_sex\n    ORDER BY RANDOM()\n    LIMIT 1\n  ) AS frase","options":{}},"id":"0864c66e-6f51-48cd-b7e8-c1e0c38f01ef","name":"📋 Tarefas + Frase1","type":"n8n-nodes-base.postgres","typeVersion":2.4,"position":[5200,704],"credentials":{"postgres":{"id":"W02Ypncbc6O8Yfvu","name":"Conecta TDAH"}}},{"parameters":{"assignments":{"assignments":[{"id":"b5aa5458-3788-4b32-93e3-138e73af839e","name":"user_phone","value":"={{ $('📦 Loop por Usuário1').item.json.user_phone }}","type":"string"},{"id":"89fd4298-670b-456a-b9e4-81c6d90c45e0","name":"created_from","value":"={{ $('📦 Loop por Usuário1').item.json.created_from }}","type":"string"},{"id":"b84f0edf-237e-4283-8c65-d2eb60cecca9","name":"last_interaction_at","value":"={{ $('📦 Loop por Usuário1').item.json.last_interaction_at }}","type":"string"},{"id":"1020dbcb-b226-4cbe-b1c8-bb4235128dbe","name":"Mensagem","value":"={{ $json.output[0].content[0].text }}","type":"string"},{"id":"bc35be90-4a8f-4d7e-b643-c0a06e7021ec","name":"frist_name","value":"={{ $('📦 Loop por Usuário1').item.json.frist_name }}","type":"string"},{"id":"82bf1e6f-3cd5-4d09-8215-4356dadd8576","name":"gender","value":"={{ $('📦 Loop por Usuário1').item.json.gender }}","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[5792,704],"id":"61b14460-e51b-471e-82f4-93b1b8fb1b89","name":"[SET] Padrao1"},{"parameters":{"workflowId":{"__rl":true,"value":"9z7dR0Ul4I4vCH-Prq4xU","mode":"list","cachedResultUrl":"/workflow/9z7dR0Ul4I4vCH-Prq4xU","cachedResultName":"Envio de  WhatsApp"},"workflowInputs":{"mappingMode":"defineBelow","value":{},"matchingColumns":[],"schema":[],"attemptToConvertTypes":false,"convertFieldsToString":true},"options":{"waitForSubWorkflow":false}},"type":"n8n-nodes-base.executeWorkflow","typeVersion":1.3,"position":[6240,1056],"id":"0872c4dc-5819-4fee-bafa-14dabe22e68b","name":"Call 'Envio de  WhatsApp'1"},{"parameters":{"operation":"executeQuery","query":"SELECT\n  us.user_phone,\n  us.manha_time::text,\n  COALESCE(u.frist_name, u.name, 'você') AS frist_name,\n  u.gender,\n  u.last_interaction_at::text,\n  u.created_from\nFROM user_settings us\nJOIN users u ON u.phone = us.user_phone\nJOIN active_subscriptions sub ON sub.user_phone = us.user_phone\nWHERE us.report_manha = true\n  AND (\n    u.onboarding IS NULL\n    OR u.onboarding = 0\n    OR u.onboarding >= 1\n  )","options":{}},"id":"4ac3cc92-55dc-4b3c-806d-2813fc084c28","name":"🔍 Usuários Elegíveis Manhã2","type":"n8n-nodes-base.postgres","typeVersion":2.4,"position":[3840,1696],"credentials":{"postgres":{"id":"W02Ypncbc6O8Yfvu","name":"Conecta TDAH"}}},{"parameters":{"rule":{"interval":[{"field":"cronExpression","expression":"0 8 * * *"}]}},"id":"cd675216-ae37-4dc4-b89c-c0298c1ec683","name":"envia as 8","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[3392,1696]},{"parameters":{"assignments":{"assignments":[{"id":"a282fe47-fde4-4f1b-b3ca-57e2fc09a3c9","name":"Mensagem","value":"=Bom dia, {{ $json.frist_name ? $json.frist_name.charAt(0).toUpperCase() + $json.frist_name.slice(1).toLowerCase() : '' }}! Tudo bem?\n\nEste final de semana, você tem algo pra desafogar a sua mente 🧠🕊️ ou vai descansar 😎?","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[5712,944],"id":"52e3d33b-36e3-4154-b814-f613c84e08d3","name":"Edit Fields"},{"parameters":{"assignments":{"assignments":[{"id":"b5aa5458-3788-4b32-93e3-138e73af839e","name":"user_phone","value":"={{ $('📦 Loop por Usuário1').item.json.user_phone }}","type":"string"},{"id":"89fd4298-670b-456a-b9e4-81c6d90c45e0","name":"created_from","value":"={{ $('📦 Loop por Usuário1').item.json.created_from }}","type":"string"},{"id":"b84f0edf-237e-4283-8c65-d2eb60cecca9","name":"last_interaction_at","value":"={{ $('📦 Loop por Usuário1').item.json.last_interaction_at }}","type":"string"},{"id":"1020dbcb-b226-4cbe-b1c8-bb4235128dbe","name":"Mensagem","value":"={{ $json.Mensagem }}","type":"string"},{"id":"bc35be90-4a8f-4d7e-b643-c0a06e7021ec","name":"frist_name","value":"={{  ( $('📦 Loop por Usuário1').item.json.frist_name || '').toLowerCase().replace(/^./, function(c){ return c.toUpperCase(); }) }}","type":"string"},{"id":"82bf1e6f-3cd5-4d09-8215-4356dadd8576","name":"gender","value":"={{ $('📦 Loop por Usuário1').item.json.gender }}","type":"string"},{"id":"8676569c-7428-4825-a15f-918f31cc174e","name":"data e hora","value":"={{ $now.setLocale('pt-BR').toFormat('dd/MM/yyyy HH:mm:ss') }}","type":"string"},{"id":"ed6672e7-fd0d-454a-a87b-fa1e7e6704c3","name":"from","value":"Mensagem da Manhã","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[6016,1056],"id":"437dc889-49bc-43ca-aafc-865687bfacba","name":"[SET] Padrao"},{"parameters":{"modelId":{"__rl":true,"value":"gpt-4o-mini","mode":"list","cachedResultName":"GPT-4O-MINI"},"responses":{"values":[{"content":"=Primeiro nome do usuário:{{ ($('📦 Loop por Usuário1').item.json.frist_name || '').toLowerCase().replace(/^./, function(c){ return c.toUpperCase(); }) }}\n\nGenero: {{ $('📦 Loop por Usuário1').item.json.gender }}\n\nFrase Dopaminérgica: {{ $json.frase }}"},{"role":"system","content":"=Você é a Desafoga, assistente de produtividade para pessoas com TDAH.\nTom: caloroso, animado e direto — como uma amiga próxima que te conhece bem.\nUse emojis para dar vida à mensagem — incentivados, mas sem exagerar (máximo 2 por linha).\n\nNunca use linguagem fria ou corporativa. WhatsApp-friendly (*negrito* OK).\n\nFORMATAÇÃO WHATSAPP — OBRIGATÓRIO\nO WhatsApp usa asterisco SIMPLES para negrito: *assim*\nNUNCA use asterisco duplo: **assim** — não funciona no WhatsApp.\nCorreto: *Olá!*\nErrado: **Olá!**\n\n━━━━━━━━━━━━━━━━━━━━\nContexto\n━━━━━━━━━━━━━━━━━━━━\nMensagem com uma frase motivacional previamente disponibilizada. Essa mensagem tem o objetivo de estimular o uso do agente, relatando as tarefas que tem que fazer. Essa parte do relatar as atividades chamamos de \"Desafogar a mente\"no sentido de usar o agente para organizar as coisas\n\n━━━━━━━━━━━━━━━━━━━━\nREGRAS OBRIGATÓRIAS\n━━━━━━━━━━━━━━━━━━━━\n\n1. Abra SEMPRE com chamando o usuário pelo nome e com uma pegada frase motivacional, numa frase com energia — reconheça o esforço de estar aqui, não pressione.\n\n\n2. Após, Frase Dopaminérgica fornecida — pode adaptar levemente para soar natural, mas preserve a essência e os emojis originais.\n\n3.  Encerre perguntando se tem algo para desafogar.\n\n4. Adapte adjetivos e verbos ao gênero indicado.\n\n5. Use emotions de acordo com o texto\n\n━━━━━━━━━━━━━━━━━━━━\nESTRUTURA DA MENSAGEM (ordem obrigatória)\n━━━━━━━━━━━━━━━━━━━━\n\n[1] Saudação pelo nome + uma frase para se ter um dia proveitoso\n[2] Frase Dopaminérgica adaptada ao genero e de forma energica.\n[3] Pergunte se tem algo para desafogar\n\n━━━━━━━━━━━━━━━━━━━━\nPROIBIDO\n━━━━━━━━━━━━━━━━━━━━\n- Usar linguagem de cobrança, culpa ou pressão\n- Omitir qualquer tarefa atrasada ou tarefa de hoje recebida no prompt\n- Inverter a ordem dos blocos\n- Terminar sem o bloco de engajamento\n- Fazer mais de 2 perguntas no bloco de engajamento\n- Parágrafos longos — prefira frases curtas e respiradas\n- NUNCA INVENTE NOME OU ATIVIDADES, NUNCA!"}]},"builtInTools":{},"options":{}},"type":"@n8n/n8n-nodes-langchain.openAi","typeVersion":2.1,"position":[5440,704],"id":"a677b1ed-cf16-4301-be4a-9c4d2234581c","name":"Mensagem Dia Util1","credentials":{"openAiApi":{"id":"AkYleDMMi1ZStZWC","name":"Connect TDAH"}}},{"parameters":{"operation":"executeQuery","query":"SELECT\n  us.user_phone,\n  us.manha_time::text,\n  COALESCE(u.frist_name, u.name, 'você') AS frist_name,\n  u.gender,\n  u.last_interaction_at::text,\n  u.created_from\nFROM user_settings us\nJOIN users u ON u.phone = us.user_phone\nJOIN active_subscriptions sub ON sub.user_phone = us.user_phone\nWHERE us.report_manha = true\n  AND (\n    u.onboarding IS NULL\n    OR u.onboarding = 0\n    OR u.onboarding >= 1\n  )","options":{}},"id":"a00584d9-437c-4561-95e3-94767b077453","name":"🔍 Usuários Elegíveis Manhã","type":"n8n-nodes-base.postgres","typeVersion":2.4,"position":[3616,1504],"credentials":{"postgres":{"id":"W02Ypncbc6O8Yfvu","name":"Conecta TDAH"}}},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"a72b9a47-8428-4248-8bca-187735be720d","leftValue":"={{ $json.user_phone }}","rightValue":"5571991616540","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.filter","typeVersion":2.3,"position":[3840,1504],"id":"4deef16e-981f-45fc-a694-e76d29d9a5cc","name":"Filter"},{"parameters":{},"type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[3392,1504],"id":"b4cd4423-737d-42dc-9ba6-c2674c3cbe88","name":"When clicking ‘Execute workflow’"},{"parameters":{"operation":"get","tableId":"users","filters":{"conditions":[{"keyName":"phone","keyValue":"={{ $json.user_phone }}"}]}},"type":"n8n-nodes-base.supabase","typeVersion":1,"position":[7616,672],"id":"d4396acc-ca65-496c-b880-5430ba0ceb8d","name":"Get a row","retryOnFail":true,"credentials":{"supabaseApi":{"id":"mC2MbgYHJZEoitKD","name":"Conecta TDAH"}}},{"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"defab5b9-4b27-4a9d-