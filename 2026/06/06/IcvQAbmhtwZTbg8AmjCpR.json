{"nodes":[{"parameters":{"options":{}},"id":"d82b453e-3266-405f-b7cb-96783de5f552","name":"📦 Loop por Usuário1","type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[4240,1440]},{"parameters":{"jsCode":"const item = $input.item.json;\n\n// Calcula dia da semana em São Paulo (UTC-3)\nconst now = new Date();\nconst spTime = new Date(now.toLocaleString('en-US', { timeZone: 'America/Sao_Paulo' }));\nconst dow = spTime.getDay(); // 0=Dom, 1=Seg ... 6=Sab\n\nconst dias = ['Domingo','Segunda-feira','Terça-feira','Quarta-feira','Quinta-feira','Sexta-feira','Sábado'];\nconst isWeekend = dow === 0 || dow === 6;\n\nreturn [{\n  json: {\n    ...item,\n    dow,\n    dia_semana: dias[dow],\n    is_weekend: isWeekend\n  }\n}];"},"id":"7cd70324-ff17-44c9-80b5-110893ff5afb","name":"📅 Dia da Semana1","type":"n8n-nodes-base.code","typeVersion":2,"position":[4624,1184]},{"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":1},"conditions":[{"leftValue":"={{ $json.dow.toString() }}","rightValue":"6","operator":{"type":"string","operation":"equals"},"id":"0ffbf4b3-7469-4fbd-b4a1-d47e9c43339e"}],"combinator":"and"},"renameOutput":true,"outputKey":"Sabado"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":1},"conditions":[{"id":"fce36060-f1e4-415f-8abc-75bfd26badec","leftValue":"={{ $json.dow.toString() }}","rightValue":"0","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"Domingo"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":1},"conditions":[{"id":"d9cc7859-c663-4d55-a5ec-033816984ce7","leftValue":"={{ $json.dow.toString() }}","rightValue":"=1","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"Segunda"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict",