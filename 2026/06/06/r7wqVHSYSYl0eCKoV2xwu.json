","credentials":{"redis":{"id":"ATvmiFw0n1ZL9GdQ","name":"Redis account"}}},{"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":2},"conditions":[{"leftValue":"={{ $('get-msg-list1').item.json['merge-msg'] }}","rightValue":"={{ $('get-msg-list2').item.json['merge-msg'] }}","operator":{"type":"string","operation":"equals"},"id":"f6af195c-a49f-4ddd-a9a0-92d286954d2d"}],"combinator":"and"},"renameOutput":true,"outputKey":"yes"}]},"looseTypeValidation":true,"options":{}},"type":"n8n-nodes-base.switch","typeVersion":3.2,"position":[-832,704],"id":"277b7681-c1d3-4824-ba33-59812e19f83c","name":"MsgsMatch?"},{"parameters":{"content":"## Messages Buffer","height":448,"width":640,"color":6},"type":"n8n-nodes-base.stickyNote","position":[-864,416],"typeVersion":1,"id":"7dae7340-caef-4816-976e-3834d809a034","name":"Sticky Note11"},{"parameters":{"content":"## New Lead?\n\n","height":400,"width":512,"color":5},"type":"n8n-nodes-base.stickyNote","position":[-192,448],"typeVersion":1,"id":"61ed136d-e9da-43bb-84db-18b0aaadf83a","name":"Sticky Note15"},{"parameters":{"assignments":{"assignments":[{"id":"e609b363-800c-4bdb-a0c3-08955f308065","name":"merge-msg","value":"={{ $json['merge-msg'].join(\" \") }}","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[-672,704],"id":"0194b464-d343-4cc3-83e6-5f98d6622135","name":"single-msg"},{"parameters":{"jsCode":"return items.map(item => {\n  const key = item.json.body?.data?.key || {};\n\n  const remoteJid = key.remoteJid;\n  const remoteJidAlt = key.remoteJidAlt;\n\n  let chosen = null;\n\n  // 1. Se for um número normal do WhatsApp\n  if (typeof remoteJid === 'string' && remoteJid.includes('@s.whatsapp.net')) {\n    chosen = remoteJid;\n  }\n  // 2. Se for um JID com @lid, então usa o remoteJidAlt\n  else if (typeof remoteJid === 'string' && remoteJid.includes('@lid')) {\n    chosen = remoteJidAlt || null;\n  }\n  // 3. (Opcional) se quiser ainda testar o remoteJidAlt para @s.whatsapp.net\n  else if (typeof remoteJidAlt === 'string' && remoteJidAlt.includes('@s.whatsapp.net')) {\n    chosen = remoteJidAlt;\n  }\n  // 4. Fallback geral\n  else {\n    chosen = remoteJidAlt || remoteJid || null;\n  }\n\n  item.json.remoteJid = chosen;\n\n  return item;\n});\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-1200,592],"id":"ef3725c3-da8b-4d75-9c41-e4360cd4c09f","name":"Jid or Alt?"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"ef8e258c-62db-48b4-b8f4-04646d565222","leftValue":"={{ $json.num }}","rightValue":"5513997779667@s.whatsapp.net","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}},{"id":"4be761a0-1aca-4e65-8854-3e40f1ec0d71","leftValue":"={{ $json.num }}","rightValue":"5511945145345@s.whatsapp.net","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}},{"id":"625a3dc0-d2ac-42e6-a68b-11edabf61105","leftValue":"={{ $json.num }}","rightValue":"5511921481540@s.whatsapp.net","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"or"},"options":{}},"type":"n8n-nodes-base.filter","typeVersion":2.2,"position":[144,-512],"id":"85543a71-e5c9-4c87-a636-c80af74cc7fc","name":"VitorTesting","alwaysOutputData":false,"disabled":true},{"parameters":{"content":"## Intervention","height":352,"width":624,"color":2},"type":"n8n-nodes-base.stickyNote","position":[1440,-304],"typeVersion":1,"id":"55fe3914-a71e-4dbe-acbe-5cce57dc70f5","name":"Sticky Note8"},{"parameters":{"content":"## Send Message\n","height":224,"width":688},"type":"n8n-nodes-base.stickyNote","position":[1280,528],"typeVersion":1,"id":"482e131a-74ea-46aa-89fe-9f14c857bc58","name":"Sticky Note3"},{"parameters":{"jsCode":"const mensagem = ($json.body ?? '').toString();\n\nconst endSession = $json.endSession === true;\n\n// Classe de emojis (mantém a flag 'u' no regex!)\nconst emojiClass = '[\\\\u{1F600}-\\\\u{1F64F}\\\\u{1F300}-\\\\u{1F5FF}\\\\u{1F680}-\\\\u{1F6FF}\\\\u{1F1E0}-\\\\u{1F1FF}\\\\u2600-\\\\u26FF\\\\u2700-\\\\u27BF]';\n\n// Montagem do pattern de forma segura (sem concatenação quebrável)\nconst parts = [\n  '(https?:\\\\/\\\\/\\\\S+|www\\\\.\\\\S+|\\\\b[\\\\w.-]+@[A-Za-z.-]+\\\\.[A-Za-z]{2,6}\\\\b)',         // g1\n\n  `([^\\\\.0-9\\\\s])(\\\\.)(\\\\s*?)(${emojiClass})(\\\\s|$)`,                                 // g2..g6   \".\" + emojis\n  `([^0-9\\\\s])(!)(\\\\s*?)(${emojiClass})(\\\\s|$)`,                                      // g7..g11  \"!\" + emojis\n  `([^0-9\\\\s])(\\\\?)(\\\\s*?)(${emojiClass})(\\\\s|$)`,                                    // g12..g16 \"?\" + emojis\n  `([^0-9\\\\s])(:)(\\\\s*?)(${emojiClass})(\\\\s|$)`,                                      // g17..g21 \":\" + emojis\n\n  `([^\\\\.0-9\\\\s])(\\\\.)(\\\\s|$)`,                                                       // g22..g24 \".\" normal\n  `([^0-9\\\\s])(!)(\\\\s|$)`,                                                            // g25..g27 \"!\" normal\n  `([^0-9\\\\s])(\\\\?)(\\\\s|$)`,                                                          // g28..g30 \"?\" normal\n  `([^0-9\\\\s])(:)(\\\\s|$)`                                                             // g31..g33 \":\" normal\n];\n\nconst pattern = parts.join('|');\nconst regex = new RegExp(pattern, 'gu');\n\n// Marca delimitadores\nconst marcado = mensagem.replace(\n  regex,\n  (\n    match,\n    g1,                      // URL/email\n\n    g2,g3,g4,g5,g6,          // \".\" + emojis\n    g7,g8,g9,g10,g11,        // \"!\" + emojis\n    g12,g13,g14,g15,g16,     // \"?\" + emojis\n    g17,g18,g19,g20,g21,     // \":\" + emojis\n\n    g22,g23,g24,             // \".\" normal\n    g25,g26,g27,             // \"!\" normal\n    g28,g29,g30,             // \"?\" normal\n    g31,g32,g33              // \":\" normal\n  ) => {\n    // URLs/emails → corta após (sempre bom isolar link)\n    if (g1) return g1 + '|';\n\n    // Pontuação seguida de emojis → coloca '|' depois dos emojis\n    if (g2)  return g2  + g3  + g4  + g5  + '|' + (g6  || '');\n    if (g7)  return g7  + g8  + g9  + g10 + '|' + (g11 || '');\n    if (g12) return g12 + g13 + g14 + g15 + '|' + (g16 || '');\n    if (g17) return g17 + g18 + g19 + g20 + '|' + (g21 || '');\n\n    // Caso normal (pontuação seguida de espaço ou fim)\n    if (g22) return g22 + g23 + '|' + (g24 || '');\n    if (g25) return g25 + g26 + '|' + (g27 || '');\n    if (g28) return g28 + g29 + '|' + (g30 || '');\n    if (g31) return g31 + g32 + '|' + (g33 || '');\n\n    return match;\n  }\n);\n\n// Split final\nconst chunks = marcado\n  .split('|')\n  .map(s => s.trim())\n  .filter(Boolean);\n\nconst total = chunks.length;\n\nreturn chunks.map((part, i) => ({\n  json: {\n    ...$json,            // preserva channel, num, status etc.\n    endSession,          // **normalizado aqui** ('' ou true)\n    output: part,        // texto da bolha\n    index: i + 1,\n    total,\n    isLast: i === total - 1\n  }\n}));"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1488,592],"id":"ef7bf574-7636-45dd-9019-5890d35680ba","name":"msg-splitter"},{"parameters":{"mode":"insert","messages":{"messageValues":[{"type":"ai","message":"={{ $json.body }}"}]}},"type":"@n8n/n8n-nodes-langchain.memoryManager","typeVersion":1.1,"position":[1824,832],"id":"53f1d92d-0d5a-4e78-9ce4-630d077da72b","name":"Chat Memory Manager1"},{"parameters":{"assignments":{"assignments":[{"id":"663bb2cb-53b9-4551-899c-65b07e161ed8","name":"endSession","value":"={{ $json.endSession ?? false }}","type":"boolean"},{"id":"75d1b9b6-6f31-4349-9109-e9588f6b2e3d","name":"body","value":"={{ $json.body }}","type":"string"}]},"includeOtherFields":true,"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[1312,592],"id":"29e12bac-c1d7-4941-ae8f-cbff8c89652c","name":"Formatter"},{"parameters":{"sessionIdType":"customKey","sessionKey":"=history_{{ $('norms').item.json.num }}","tableName":"chat_history","contextWindowLength":30},"type":"@n8n/n8n-nodes-langchain.memoryPostgresChat","typeVersion":1.3,"position":[2080,848],"id":"8ac5e135-e356-472d-8005-fb2aa1aa002d","name":"Postgres1","credentials":{"postgres":{"id":"W02Ypncbc6O8Yfvu","name":"Conecta TDAH"}}},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"adaf7407-158c-48ce-b4c1-17dba710ab6e","leftValue":"={{ $('get status').item.json.status }}","rightValue":"STORY_RESPONDED","operator":{"type":"string","operation":"notEquals"}},{"id":"edb16928-5ff4-4cdf-bfd0-aa64ca786de6","leftValue":"={{ $('get status').item.json.status }}","rightValue":"WAITING_48HFU","operator":{"type":"string","operation":"notEquals"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.filter","typeVersion":2.2,"position":[1488,832],"id":"bbacb3fd-c58c-40ae-ae8f-f69f9ac986e2","name":"filter spin talk"},{"parameters":{"promptType":"define","text":"={{ $('single-msg').item.json['merge-msg'] }}","options":{"systemMessage":"=# Contexto\n\nVocê é Luiza, uma assistente que faz um pré-atendimento com leads interessados em atingir maior paz mental e que buscam orientação mental, de rotina e pessoal. A grande maioria deles possui TDAH.\n\nAnteriormente, foi perguntado o nome do lead e sua história com o TDAH e você deverá responder com uma mensagem completa dividida em partes. \n\n1. Sua primeira ação deve ser REGISTRAR/SALVAR o nome recém descoberto do lead no banco de dados da automação através da ferramenta \"LeadName\" disponível.\n\n2. Depois do nome, interprete as mensages do lead, compreenda sua história de vida tendo TDAH e responda ao depoimento dele de forma Casual, calorosa e mostrando que vai ajudar. Comentando sobre os acontecimentos da vida dele e o acolhendo (sempre tentando mencionar o nome do lead para gerar conexão). UTILIZE NO MÁXIMO 300 CARACTERES\n\nATENÇÃO: Seja breve ao acolher a história e não dê espaço para mais desabafos (seu papel deve ser eficiente e não permite papo furado)\n\n---\n\n# Ferramentas Disponíveis\n\n1. Tool “LeadName”\n   * Usada **sempre que descobrir o nome do Lead**.\n   * Só armazene se for claramente um **nome de fato**.\n\n2. Tool “Think”\n   * Usar antes de cada ação.\n   * Serve para organizar o raciocínio:\n     * O que já sei sobre o lead?\n     * Como personalizar minhas falas de acordo com a história do lead?\n\n---\n\n# Comando de Controle de Etapa (Anti-Pulo)\n\nSe, em qualquer momento, o lead:\n* Pedir preço ou planos,\n* Quiser pular qualquer etapa,\n* Pedir para ir “direto ao final”,\n\nVocê deve:\n1. Não ceder e não antecipar detalhes de valores/planos.\n2. Reconhecer o pedido com empatia.\n3. Repetir a mesma coisa escrita anteriormente\n\n---\n\n# Regras e Restrições (Obrigatórias)\n\n* SEMPRE use o nome do cliente assim que souber.\n* NUNCA invente conteúdos ou mencione concorrentes.\n* NUNCA responda diretamente sem antes usar a Tool “Think”;"}},"type":"@n8n/n8n-nodes-langchain.agent","typeVersion":2.2,"position":[384,688],"id":"5d6f83e9-e797-4fd5-a9a7-2e9ed6ef5474","name":"AI Agent","executeOnce":false},{"parameters":{"content":"","height":352,"width":448,"color":3},"type":"n8n-nodes-base.stickyNote","position":[352,656],"typeVersion":1,"id":"25b8c9a6-45f1-449e-9ac2-832c851d142e","name":"Sticky Note20"},{"parameters":{"operation":"update","tableId":"leads","filters":{"conditions":[{"keyName":"num","condition":"eq","keyValue":"={{ $('norms').item.json.num }}"}]},"fieldsUi":{"fieldValues":[{"fieldId":"name","fieldValue":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('fieldValues0_Field_Value', ``, 'string') }}"}]}},"type":"n8n-nodes-base.supabaseTool","typeVersion":1,"position":[576,864],"id":"4b3781ce-f54f-45de-bd42-8e7b2f854cf2","name":"LeadName","credentials":{"supabaseApi":{"id":"mC2MbgYHJZEoitKD","name":"Conecta TDAH"}}},{"parameters":{},"type":"@n8n/n8n-nodes-langchain.toolThin