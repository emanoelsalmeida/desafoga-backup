\nPeríodos:\n- \"hoje\" → date_start = date_end = hoje\n- \"ontem\" → date_start = date_end = ontem\n- \"essa semana\" → date_start = segunda, date_end = hoje\n- \"esse mês\" → date_start = dia 1, date_end = hoje\n- \"de [data] a [data]\" → extraia as datas\n\nFormato da resposta:\n\"Suas atividades de [período] — X feitas, Y pendentes:\n[list_formatted]\"\n\nSe vazio: \"Nenhuma atividade [nesse período/com esse contexto]. 😊\"\n"}},"type":"@n8n/n8n-nodes-langchain.agent","typeVersion":3,"position":[288,-64],"id":"7b1f4ffa-489b-4391-885d-847b6a4d4c00","name":"AI Agent"},{"parameters":{"assignments":{"assignments":[{"id":"r1","name":"Resposta","value":"={{ [$json.output] }}","type":"array"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[608,-64],"id":"4e2c5254-2194-4fd4-ab64-32acb6fb70a5","name":"Resposta"},{"parameters":{"model":{"__rl":true,"value":"gpt-4o-mini","mode":"list"},"builtInTools":{},"options":{}},"type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","typeVersion":1.3,"position":[64,160],"id":"1892b8b2-73ce-4fdd-88cc-99f1760eb707","name":"GPT-4o Mini","credentials":{"openAiApi":{"id":"AkYleDMMi1ZStZWC","name":"Connect TDAH"}}},{"parameters":{"sessionIdType":"customKey","sessionKey":"={{ $('Contexto').item.json.user_phone }}","contextWindowLength":20},"type":"@n8n/n8n-nodes-langchain.memoryPostgresChat","typeVersion":1.3,"position":[240,160],"id":"11842ea5-5f97-4b46-8099-987487c7c613","name":"Memória Postgres","credentials":{"postgres":{"id":"W02Ypncbc6O8Yfvu","name":"Conecta TDAH"}}},{"parameters":{"description":"Busca semântica/contextual de atividades por título ou descrição.","workflowId":{"__rl":true,"value":"CbQeWvBKA2THo-LenbbXA","mode":"list","cachedResultUrl":"/workflow/CbQeWvBKA2THo-LenbbXA","cachedResultName":"[TOOL] task_search v2"},"workflowInputs":{"mappingMode":"defineBelow","value":{"user_phone":"={{ $('Contexto').item.json.user_phone }}","query":"={{ $fromAI('query', 'Termos de busca', 'string') }}","days_back":"={{ $fr