{"nodes":[{"parameters":{"inputSource":"passthrough"},"type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1.1,"position":[14160,5776],"id":"5009c284-3df1-4a4b-9c06-fecb0be9ceff","name":"When Executed by Another Workflow"},{"parameters":{"operation":"executeQuery","query":"WITH recent_messages AS (\n  SELECT\n    id,\n    message->>'type' AS msg_type,\n    message->>'content' AS msg_content\n  FROM n8n_chat_histories\n  WHERE session_id = '{{ $json.number }}'\n  ORDER BY id DESC\n  LIMIT 6\n)\nSELECT\n  s.time_manha::text,\n  s.time_tarde::text,\n  s.time_noite::text,\n  s.time_dia::text,\n  s.manha_time::text,\n  s.tarde_time::text,\n  s.noite_time::text,\n  s.report_manha,\n  s.report_tarde,\n  s.report_noite,\n  s.report_period,\n  s.report_time::text,\n  COALESCE(\n    json_agg(c.name ORDER BY c.is_default DESC, c.name) FILTER (WHERE c.name IS NOT NULL),\n    '[]'\n  ) AS categories,\n  (\n    SELECT COALESCE(\n      json_agg(json_build_object('role', msg_type, 'text', LEFT(msg_content, 300)) ORDER BY id ASC),\n      '[]'\n    )\n    FROM recent_messages\n  ) AS recent_history\nFROM user_settings s\nLEFT JOIN categories c ON c.user_phone = s.user_phone\nWHERE s.user_phone = '{{ $json.number }}'\nGROUP BY s.time_manha, s.time_tarde, s.time_noite, s.time_dia,\n         s.manha_time, s.tarde_time, s.noite_time,\n         s.report_manha, s.report_tarde, s.report_noite,\n         s.report_period, s.report_time;","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[14608,5680],"id":"902ef21c-e170-4c4d-97ba-2c52bbe401f8","name":"Buscar Contexto Usuário","retryOnFail":true,"credentials":{"postgres":{"id":"W02Ypncbc6O8Yfvu","name":"Conecta TDAH"}}},{"parameters":{"jsCode":"const row = $input.first().json;\nconst cats = Array.isArray(row.categories) ? row.categories : JSON.parse(row.categories || '[]');\n\n// Parse histórico recente\nlet history = [];\ntry {\n  history = Array.isArray(row.recent_history) ? row.recent_history : JSON.parse(row.recent_history || '[]');\n} catch(e) {}\n\n// Montar resumo do histórico (ordem cronológica: mais antigo primeiro, mais recente por último)\nconst historyText = history\n  .map(m => `[${m.role === 'human' ? 'USUÁRIO' : 'BOT'}]: ${m.text}`)\n  .join('\\n');\n\n// Captura quoted_message (reply do WhatsApp)\nconst quotedMessage = $('[SET] Padronizacao1').first().json.quoted_message || '';\n\nconst replyBlock = quotedMessage\n  ? `\\n⚡ REPLY DETECTADO — O usuário fez reply na seguinte mensagem do bot:\\n\"\"\"\\n${quotedMessage}\\n\"\"\"\\nEssa mensagem citada é a fonte de verdade para identificar a tarefa ou contexto. Use-a ANTES do histórico.\\n`\n  : '';\n\nconst summary = [\n  `Horários padrão: manhã=${row.time_manha||'11:00'}, tarde=${row.time_tarde||'17:00'}, noite=${row.time_noite||'20:30'}, dia=${row.time_dia||'15:00'}`,\n  `Relatório manhã: ${row.report_manha ? 'ativado' : 'desativado'}`,\n  `Categorias disponíveis: ${cats.join(', ')}`,\n  replyBlock,\n  `\\n--- HISTÓRICO RECENTE (últimas mensagens, ordem cronológica — a ÚLTIMA linha é a mais recente) ---`,\n  historyText || '(sem histórico)'\n].join('\\n');\n\nreturn [{ json: { ...row, context_summary: summary, category_names: cats } }];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[14832,5680],"id":"256b9f99-bd43-4efe-afe1-ba78206aefac","name":"Montar context_summary"},{"parameters":{"assignments":{"assignments":[{"id":"a1","name":"texto","value":"={{ ($json.text || $json.body[0].text || '').replace(/^[=+\\-@]/, '') }}","type":"string"},{"id":"a2","name":"Nome","value":"={{ ($json.frist_name  ||  '').toLowerCase().replace(/^./, function(c){ return c.toUpperCase(); }) }}\n","type":"string"},{"id":"a3","name":"number","value":"={{ $json.number || $json.body[1].number }}","type":"string"},{"id":"a4","name":"message.type","value":"={{ $json.message.type }}","type":"string"},{"id":"a5","name":"mensagem.horaEnvio","value":"={{ $json.message.Timestamp.toDateTime('ms').toISO() }}","type":"string"},{"id