position":[-768,448],"id":"7898eae8-3589-4e89-8a39-735379713bbd","name":"Edit Fields1"},{"parameters":{"unit":"minutes"},"type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[-384,1472],"id":"6d1f3648-d347-451b-838f-d55153e5f3e3","name":"Wait1","webhookId":"0eeb9592-0cf7-42e2-8283-83b088bbeebc"},{"parameters":{"rule":{"interval":[{"field":"minutes"}]}},"type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.3,"position":[-2336,528],"id":"953d5d7b-a276-490e-b182-ed0647aa4cc5","name":"lembrete"},{"parameters":{"jsCode":"const texto = $input.first().json.text || '';\n\nconst blocos = texto\n  .split(/\\n\\*\\n/)\n  .map(bloco => {\n    const linhas = bloco\n      .split('\\n')\n      .map(l => l.trim())\n      .filter(l => l.length > 0);\n\n    if (linhas.length === 0) return null;\n\n    const titulo = `**${linhas[0]}**`;\n    const corpo = linhas.slice(1).join('\\n\\n');\n\n    return corpo ? `${titulo}\\n\\n${corpo}` : titulo;\n  })\n  .filter(bloco => bloco && bloco.length > 10);\n\nconsole.log(`✅ Total de mensagens: ${blocos.length}`);\n\nreturn blocos.map((msg, index) => ({\n  json: {\n    pageContent: msg,\n    metadata: {\n      id: index + 1,\n      total: blocos.length,\n      fonte: 'desafoga_frases_diarias',\n      preview: msg.replace(/\\*/g, '').substring(0, 70)\n    }\n  }\n}));"},"id":"203464ce-ad2b-49b2-8216-8231c29e3ccf","name":"separa por *","type":"n8n-nodes-base.code","typeVersion":2,"position":[1872,-16]},{"parameters":{"options":{}},"type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[2096,-16],"id":"a252c0f2-bc50-41a2-92d6-9fdddc01a831","name":"Loop Over Items1"},{"parameters":{"assignments":{"assignments":[{"id":"12eb8b8c-91db-4c32-922a-31320d45cf88","name":"whatsapp_number","value":"={{ $('Loop Over Items2').item.json.phone }}","type":"string"},{"id":"b9bd5677-9b0a-4ec2-848b-b7f0b67d53bc","name":"name","value":"={{ $json.name }}","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[-1568,1872],"id":"d46624a9-c7ee-4046-8656-d969cedfcaa3","name":"Edit Fields2","alwaysOutputData":true},{"parameters":{"options":{"reset":false}},"type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[-1808,2048],"id":"a99da9a7-95bd-47ac-b92e-281558d801f9","name":"Loop Over Items2"},{"parameters":{"operation":"getAll","tableId":"users","returnAll":true},"type":"n8n-nodes-base.supabase","typeVersion":1,"position":[-2256,2048],"id":"e57aa5be-e612-4f08-9d6c-efe1e9f62bbb","name":"buscar usuários1","credentials":{"supabaseApi":{"id":"mC2MbgYHJZEoitKD","name":"Conecta TDAH"}}},{"parameters":{"promptType":"define","text":"=Olá, {{ $json.name }}. Hoje é dia {{ $now.format('dd/MM/yyyy') }}. \n\nSiga estas etapas agora:\n1. Busque minhas tarefas para hoje na tool 'verTarefas'.\n2. Busque uma reflexão motivacional na tool 'fraseDopaminegicas'.\n3. Monte uma mensagem de acompanhamento personalizada para mim, listando o que encontrou e me incentivando.","options":{"systemMessage":"=# Persona e Tom\nVocê é um mentor de produtividade empático. Sua comunicação deve ser natural, como um braço direito conversando pelo WhatsApp. **Nunca use frases prontas e repetitivas como \"Aqui está seu lembrete\"**. Varie a forma de saudar e de se despedir a cada execução.\n\n# Regras Dinâmicas (Múltiplos Usuários)\n- Use sempre o nome **{{ $json.name }}** de forma orgânica no texto.\n- Flexão de Gênero: Identifique pelo nome ou use termos neutros/acolhedores.\n\n# Execução das Ferramentas\n1. **Tarefas de Hoje:** Chame 'verTarefas' (data: {{ $now.format('yyyy-MM-dd') }}). \n   - Se houver tarefas: Liste os NOME das tarefas de forma clara.\n   - Se não houver: Comente que a agenda está limpa e pergunte se algo novo surgiu.\n2. **Motivação:** Chame 'fraseDopaminegicas'. Use o 'pageContent' do maior score EXATAMENTE como recebido. **Essa frase é o coração da variação da mensagem.**\n\n# Estrutura da Resposta (Não engessada)\n- Saudação calorosa e variada usando o nome do usuário.\n- Uma breve frase de conexão sobre o dia de hoje.\n- Listagem das tarefas adicionadas para hoje.\n- Pergunta direta: \"Quais dessas você já conseguiu matar hoje? ✅\"\n- [Espaço para a Frase da tool fraseDopaminegicas]\n\n# Restrições\n- Máximo 2 emojis seus.\n- Proibido inventar tarefas.\n- Proibido resumir a frase motivacional."}},"type":"@n8n/n8n-nodes-langchain.agent","typeVersion":3,"position":[-1248,1872],"id":"8eb15055-63aa-49bc-938d-bd38b097ea2c","name":"AI Agent1"},{"parameters":{"model":{"__rl":true,"value":"gpt-4o-mini","mode":"list","cachedResultName":"gpt-4o-mini"},"builtInTools":{},"options":{}},"type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","typeVersion":1.3,"position":[-1360,2096],"id":"074c375a-c3f9-416c-8a71-22d7bd9d4c5d","name":"OpenAI Chat Model1","credentials":{"openAiApi":{"id":"AkYleDMMi1ZStZWC","name":"Connect TDAH"}}},{"parameters":{"sessionIdType":"customKey","sessionKey":"={{ $json.whatsapp_number }}"},"type":"@n8n/n8n-nodes-langchain.memoryPostgresChat","typeVersion":1.3,"position":[-1232,2096],"id":"ea777149-febd-4d3d-bf46-046d1bd0910d","name":"Postgres Chat Memory1","credentials":{"postgres":{"id":"W02Ypncbc6O8Yfvu","name":"Conecta TDAH"}}},{"parameters":{"amount":3},"type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[240,2016],"id":"062a1dfe-a4e5-4e35-9069-9227e38a2729","name":"Wait2","webhookId":"8996c7fb-665b-4b29-a85b-d71a7fba1d8d","disabled":true},{"parameters":{"options":{}},"type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[-160,1872],"id":"bcaca78e-5143-430e-9b53-8adeb91b4976","name":"Loop Over Items12"},{"parameters":{"assignments":{"assignments":[{"id":"ad0d30b3-1f48-4cc3-b764-1df24bd1d66b","name":"Resposta","value":"={{ $json.output }}","type":"string"},{"id":"38d478de-1ed2-47d8-a3fe-d727f94f3b8e","name":"","value":"","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[-608,1872],"id":"352befb3-a4c1-4ab1-954f-7e71691b2884","name":"Tratar dados finais1","alwaysOutputData":false,